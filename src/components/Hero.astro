---
import { cvUrl } from "../data/site";
import MetricCard from "./MetricCard.astro";

const heroMetrics = [
  {
    value: "50+",
    label: "Stakeholders served",
    valueKey: "hero.pill1.value",
    labelKey: "hero.pill1.label",
    countTarget: 50,
    suffix: "+"
  },
  {
    value: "12h -> 2m",
    label: "Manual process reduced",
    valueKey: "hero.pill2.value",
    labelKey: "hero.pill2.label"
  },
  {
    value: "AI",
    label: "Hands-on MVP delivery",
    valueKey: "hero.pill3.value",
    labelKey: "hero.pill3.label"
  }
];
---

<section class="hero-editorial relative mx-auto overflow-hidden bg-color-bg px-4 pb-12 pt-24 sm:px-6 sm:pb-16 sm:pt-28 lg:min-h-[650px] lg:max-w-6xl lg:px-8" data-reveal>
  <div class="hero-editorial-copy relative z-[3] max-w-none text-left lg:ms-[34%] lg:max-w-[64%] rtl:text-right">
    <p class="mb-4 text-[11px] font-normal uppercase leading-none tracking-[0.15em] text-color-text-secondary" data-i18n="hero.eyebrow">
      JUNIOR PRODUCT MANAGER CANDIDATE
    </p>
    <h1
      class="font-display-en text-[56px] font-light italic leading-none text-color-text-primary sm:text-[72px] lg:text-[104px]"
      data-i18n="hero.name"
    >
      Hoshen Lichi
    </h1>
    <div class="my-5 h-0.5 w-16 bg-color-primary"></div>
    <p class="max-w-[620px] text-base leading-[1.6] text-color-text-primary sm:text-lg" data-i18n="hero.positioning">
      I turn real needs into working solutions. With a background in military operations and hands-on AI implementation, I bring structured thinking, user empathy, and a bias for execution to every product challenge.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary" href="#projects" data-i18n="hero.cta.cases">View Case Studies</a>
      <a class="btn btn-secondary" href="#contact" data-i18n="hero.cta.contact">Contact Me</a>
      <a class="btn btn-ghost" href={cvUrl} download data-i18n="hero.cta.cv">Download CV</a>
    </div>
    <div class="mt-7 grid gap-3 sm:grid-cols-3 lg:max-w-[660px]">
      {
        heroMetrics.map((metric) => (
          <MetricCard
            variant="pill"
            value={metric.value}
            label={metric.label}
            valueKey={metric.valueKey}
            labelKey={metric.labelKey}
            countTarget={metric.countTarget}
            suffix={metric.suffix}
          />
        ))
      }
    </div>
  </div>

  <figure class="hero-editorial-portrait relative z-[2] mx-auto mt-8 w-full max-w-[420px] overflow-visible sm:max-w-[460px] lg:absolute lg:left-[-21%] lg:top-[-5%] lg:mt-0 lg:w-[min(84vw,900px)] lg:max-w-[577px] lg:translate-y-[10px] lg:rotate-[-2deg] xl:left-[-18%] xl:w-[min(78vw,960px)]">
    <img
      src="/assets/images/hoshens_photo_2_hq-removebg-preview.png"
      alt="Hoshen Lichi, Junior Product Manager Candidate"
      data-i18n-attr="alt:hero.profileAlt"
      width={577}
      height={433}
      loading="eager"
      decoding="async"
      fetchpriority="high"
      class="hero-editorial-image h-auto w-full object-contain object-bottom"
    />
  </figure>
</section>
