---
import en from "../i18n/en.json";

type Project = {
  titleKey: string;
  taglineKey: string;
  metricKey: string;
  tagKeys?: string;
  heroImage: string | null;
  heroImageAltKey: string | null;
  heroImageBefore: string | null;
  heroImageBeforeAltKey: string | null;
  heroImageAfter: string | null;
  heroImageAfterAltKey: string | null;
  projectUrl: string | null;
};

const { project } = Astro.props as { project: Project };
const copy = (key: string | null) => (key ? en[key as keyof typeof en] ?? key : "");
const title = copy(project.titleKey);
const oneLiner = copy(project.taglineKey);
const outcome = copy(project.metricKey);
const tags = copy(project.tagKeys ?? null).split("|").filter(Boolean).slice(0, 4);
const heroImage = project.heroImage ?? project.heroImageAfter ?? project.heroImageBefore;
const heroImageAltKey = project.heroImageAltKey ?? project.heroImageAfterAltKey ?? project.heroImageBeforeAltKey;
const initials = title
  .split(/\s+/)
  .map((word) => word[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<article class="project-card">
  <div class="card-image-wrapper">
    {
      heroImage ? (
        <img
          src={heroImage}
          alt={copy(heroImageAltKey)}
          data-i18n-attr={`alt:${heroImageAltKey}`}
          width="760"
          height="400"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="card-image-placeholder">
          <span class="card-initials" aria-hidden="true">{initials}</span>
        </div>
      )
    }
  </div>

  <div class="card-content">
    <h3 class="card-title" data-i18n={project.titleKey}>{title}</h3>
    <p class="card-oneliner" data-i18n={project.taglineKey}>{oneLiner}</p>
    <p class="card-outcome" data-i18n={project.metricKey}>{outcome}</p>
    <div class="card-tags" data-i18n-list={project.tagKeys}>
      {tags.map((tag) => <span>{tag}</span>)}
    </div>
    {
      project.projectUrl && (
        <a href={project.projectUrl} class="card-cta">
          <span data-i18n="projects.card.viewCaseStudy">View Case Study</span>
          <span aria-hidden="true"> →</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .project-card {
    flex: 0 0 340px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: 0 2px 12px rgba(74, 74, 74, 0.07);
    transition: box-shadow 0.3s ease;
  }

  .project-card:hover {
    box-shadow: 0 8px 28px rgba(74, 74, 74, 0.13);
  }

  .card-image-wrapper {
    height: 220px;
    overflow: hidden;
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
  }

  .project-card:hover .card-image-wrapper img {
    transform: scale(1.04);
  }

  .card-image-placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-surface-tinted) 0%, var(--color-featured-bg) 100%);
  }

  .card-initials {
    color: var(--color-border);
    font-family: "Cormorant Garamond", "Frank Ruhl Libre", serif;
    font-size: 64px;
    font-style: italic;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px 24px;
  }

  .card-title {
    margin: 0;
    color: var(--color-accent-dark);
    font-family: "Cormorant Garamond", "Frank Ruhl Libre", serif;
    font-size: 22px;
    font-style: italic;
    font-weight: 600;
    line-height: 1.2;
  }

  .card-oneliner {
    margin: 0;
    color: var(--color-text-secondary);
    font-family: "DM Sans", "Heebo", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.4;
    display: -webkit-box;
    min-height: 36px;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-outcome {
    margin: 4px 0 6px;
    color: var(--color-accent-dark);
    font-family: "DM Sans", "Heebo", system-ui, sans-serif;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }

  :global(.card-tags) {
    /* Runtime i18n replaces chip nodes, so this must stay global to beat scoped/runtime mismatch. */
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 6px !important;
    align-content: flex-start;
    margin-block: 2px 8px;
    min-width: 0;
  }

  :global(.card-tags > *) {
    flex: 0 1 auto;
    max-width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface-tinted) 62%, transparent);
    color: var(--color-text-secondary);
    font-family: "DM Sans", "Heebo", system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    list-style: none;
    overflow-wrap: anywhere;
    padding: 6px 9px;
  }

  .card-cta {
    display: inline-block;
    margin-top: 4px;
    color: var(--color-link);
    font-family: "DM Sans", "Heebo", system-ui, sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }

  .card-cta:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
