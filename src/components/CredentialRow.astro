---
import en from "../i18n/en.json";

const credentials = [
  "about.credential1",
  "about.credential2",
  "about.credential3"
];

const copy = (key: string) => en[key as keyof typeof en] ?? key;
---

<div class="mt-8 grid gap-3 sm:grid-cols-3" aria-label="Product management credentials">
  {
    credentials.map((key) => (
      <article class="rounded-lg border border-color-border bg-[rgba(212,165,165,0.08)] p-4 shadow-card">
        <p class="text-sm font-semibold leading-[1.45] text-color-text-primary" data-i18n={key}>
          {copy(key)}
        </p>
      </article>
    ))
  }
</div>
