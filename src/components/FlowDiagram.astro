---
import en from "../i18n/en.json";

const steps = [
  "featured.flow.step1",
  "featured.flow.step2",
  "featured.flow.step3",
  "featured.flow.step4",
  "featured.flow.step5",
  "featured.flow.step6"
];

const copy = (key: string) => en[key as keyof typeof en] ?? key;
---

<article class="rounded-lg border border-color-border bg-color-surface p-5 shadow-card">
  <h4 class="text-base font-semibold text-color-text-primary" data-i18n="featured.flow.heading">
    Main User Flow
  </h4>
  <ol class="mt-5 grid gap-3 md:grid-cols-3">
    {
      steps.map((key, index) => (
        <li class="relative rounded-lg border border-color-border bg-color-surface-tinted p-4">
          <span class="mb-2 inline-flex h-7 w-7 items-center justify-center rounded-full bg-color-accent-dark text-sm font-semibold text-white">
            {index + 1}
          </span>
          <p class="text-sm leading-[1.45] text-color-text-primary" data-i18n={key}>
            {copy(key)}
          </p>
        </li>
      ))
    }
  </ol>
</article>
