---
const navItems = [
  { href: "#about", key: "nav.about", text: "About" },
  { href: "#how-i-build", key: "nav.howIBuild", text: "How I Build" },
  { href: "#product-skills", key: "nav.productSkills", text: "Product Skills" },
  { href: "#projects", key: "nav.projects", text: "Projects" }
];
---

<nav
  aria-label="Main navigation"
  class="fixed inset-x-0 top-0 z-50 border-b border-color-border bg-color-bg/95 backdrop-blur"
  data-nav
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a
      href="#main"
      class="font-body-en text-sm font-semibold tracking-[0.08em] text-color-text-primary rtl:order-3"
      data-i18n="nav.logo"
    >
      Hoshen Lichi
    </a>

    <div class="hidden items-center gap-8 sm:flex rtl:order-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="border-b-2 border-transparent pb-1 text-sm font-semibold text-color-text-secondary hover:border-color-primary hover:text-color-text-primary"
            data-nav-link
            data-i18n={item.key}
          >
            {item.text}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2 rtl:order-1">
      <a
        href="#contact"
        class="rounded-full bg-color-primary px-4 py-1.5 text-sm font-semibold text-color-text-primary hover:bg-color-primary-dark"
        data-i18n="nav.pill"
      >
        Let's Talk
      </a>
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label="Switch color theme"
        aria-pressed="false"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M12 3v2.2M12 18.8V21M4.22 4.22l1.56 1.56M18.22 18.22l1.56 1.56M3 12h2.2M18.8 12H21M4.22 19.78l1.56-1.56M18.22 5.78l1.56-1.56" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M20 14.4A7.1 7.1 0 0 1 9.6 4a7.8 7.8 0 1 0 10.4 10.4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="flex rounded-full border border-color-border bg-color-surface p-1" aria-label="Language selection">
        <button
          type="button"
          class="rounded-full px-2.5 py-1 text-xs font-semibold text-color-text-secondary data-[active=true]:bg-color-primary data-[active=true]:text-color-text-primary"
          data-lang-button="en"
          data-active="true"
          aria-label="Switch to English"
        >
          EN
        </button>
        <button
          type="button"
          class="rounded-full px-2.5 py-1 text-xs font-semibold text-color-text-secondary data-[active=true]:bg-color-primary data-[active=true]:text-color-text-primary"
          data-lang-button="he"
          data-active="false"
          aria-label="Switch to Hebrew"
        >
          עב
        </button>
      </div>
    </div>
  </div>
</nav>
