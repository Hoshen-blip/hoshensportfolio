---
import techSkills from "../data/techSkills.json";
import en from "../i18n/en.json";

const copy = (key: string) => en[key as keyof typeof en] ?? key;
const cardOffsets = ["workflow-card--low", "workflow-card--high", "workflow-card--center", "workflow-card--low", "workflow-card--high"];
---

<section id="how-i-build" class="section-fade relative bg-color-tech-bg py-16 lg:py-20" data-reveal>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <h2 class="section-title font-normal" data-i18n="howIBuild.header">How I Build</h2>
    <div class="section-rule"></div>
    <p class="mb-10 max-w-2xl text-base leading-[1.65] text-color-text-primary" data-i18n="howIBuild.intro">
      I combine product discovery, AI workflow design, and practical delivery habits to move from fuzzy problems to working MVPs.
    </p>

    <div class="workflow-editorial relative" aria-label="How I Build flow">
      <figure class="workflow-origin">
        <img
          src="/assets/images/hoshens_photo-removebg-preview.png"
          alt="Hoshen Lichi"
          data-i18n-attr="alt:hero.profileAlt"
          width="436"
          height="572"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="workflow-steps">
        {
          techSkills.map((skill, index) => (
            <article class={`workflow-card ${cardOffsets[index]}`}>
              <div class="workflow-number" aria-hidden="true">{index + 1}</div>
              <h3 data-i18n={skill.titleKey}>
                {copy(skill.titleKey)}
              </h3>
              <p data-i18n={skill.descKey}>
                {copy(skill.descKey)}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .workflow-editorial {
    display: grid;
    gap: 1rem;
  }

  .workflow-editorial::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset-inline: 50%;
    top: 16.25rem;
    bottom: 2rem;
    width: 1px;
    background: linear-gradient(to bottom, rgba(122, 158, 135, 0), rgba(122, 158, 135, 0.46), rgba(122, 158, 135, 0));
    filter: drop-shadow(0 0 5px rgba(122, 158, 135, 0.2));
  }

  .workflow-origin {
    position: relative;
    z-index: 0;
    width: min(84vw, 340px);
    margin: 0 auto;
  }

  .workflow-origin::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 1% -4% 7% -3%;
    border-radius: 58% 42% 46% 54%;
    background:
      radial-gradient(ellipse at 40% 42%, rgba(122, 158, 135, 0.45), rgba(167, 190, 174, 0.34) 48%, transparent 72%),
      radial-gradient(ellipse at 62% 62%, rgba(212, 165, 165, 0.32), transparent 64%);
    filter: blur(9px);
    transform: rotate(-12deg);
  }

  .workflow-origin img {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center bottom;
  }

  .workflow-steps {
    position: relative;
    z-index: 3;
    display: grid;
    gap: 1rem;
  }

  html[data-theme="dark"] .workflow-origin::before {
    background:
      radial-gradient(ellipse at 40% 42%, rgba(122, 158, 135, 0.18), rgba(167, 190, 174, 0.08) 48%, transparent 72%),
      radial-gradient(ellipse at 62% 62%, rgba(212, 165, 165, 0.1), transparent 64%);
  }

  .workflow-card {
    position: relative;
    z-index: 1;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
    padding: 1.25rem;
    --workflow-card-offset: 0px;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
    transform: translateY(var(--workflow-card-offset));
  }

  .workflow-card:hover {
    border-color: rgba(122, 158, 135, 0.34);
    box-shadow: 0 10px 28px rgba(74, 74, 74, 0.07);
    transform: translateY(calc(var(--workflow-card-offset) - 4px)) scale(1.008);
  }

  .workflow-number {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(122, 158, 135, 0.42);
    border-radius: 999px;
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1;
  }

  .workflow-card h3 {
    margin: 0.85rem 0 0;
    color: var(--color-text-primary);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .workflow-card p {
    margin: 0.55rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.58;
  }

  @media (min-width: 1024px) {
    .workflow-editorial {
      grid-template-columns: 240px minmax(0, 1fr);
      align-items: center;
      gap: 0;
      min-height: 360px;
    }

    .workflow-editorial::before {
      inset-inline: 13.85rem 0.75rem;
      top: 45.5%;
      bottom: auto;
      width: auto;
      height: 1px;
      background: linear-gradient(to right, rgba(122, 158, 135, 0.48), rgba(122, 158, 135, 0.7), rgba(122, 158, 135, 0.24));
      filter: drop-shadow(0 0 6px rgba(122, 158, 135, 0.22));
    }

    .workflow-origin {
      width: 274px;
      margin-inline: 0;
      transform: translate(-5.75rem, -58px);
    }

    .workflow-origin img {
      transform: translateX(0);
    }

    .workflow-steps {
      display: flex;
      align-items: center;
      gap: 1rem;
      overflow: visible;
      padding-block: 2.75rem;
      padding-inline: 0;
      margin-inline-start: -1.35rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .workflow-steps::-webkit-scrollbar {
      display: none;
    }

    .workflow-card {
      flex: 1 1 0;
      min-width: 0;
      min-height: 178px;
      padding: 1.2rem 1.2rem 1.25rem;
      box-shadow: 0 8px 24px rgba(74, 74, 74, 0.035);
    }

    .workflow-card--low {
      --workflow-card-offset: 1.25rem;
    }

    .workflow-card--high {
      --workflow-card-offset: -1.25rem;
    }

    .workflow-card--center {
      --workflow-card-offset: 0px;
    }

    .workflow-card:first-child {
      margin-inline-start: -0.45rem;
    }
  }
</style>
