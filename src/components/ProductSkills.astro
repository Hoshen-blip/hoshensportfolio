---
import productSkills from "../data/productSkills.json";
import en from "../i18n/en.json";

const copy = (key: string) => en[key as keyof typeof en] ?? key;
---

<section id="product-skills" class="section-fade relative bg-color-surface-tinted py-16" data-reveal>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <h2 class="section-title font-normal" data-i18n="productSkills.header">Product Skills</h2>
    <div class="section-rule"></div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        productSkills.map((skill) => (
          <article class="rounded-lg border border-color-border bg-color-surface p-5 shadow-card transition hover:-translate-y-0.5 hover:border-color-primary">
            <span class="mb-4 block text-[28px] font-semibold leading-none text-color-accent-dark" aria-hidden="true">
              {skill.icon}
            </span>
            <h3 class="text-xl font-semibold leading-tight text-color-text-primary" data-i18n={skill.titleKey}>
              {copy(skill.titleKey)}
            </h3>
            <p class="mt-2 text-sm leading-[1.55] text-color-text-secondary" data-i18n={skill.descKey}>
              {copy(skill.descKey)}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
