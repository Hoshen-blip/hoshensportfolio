---
import { cvUrl, emailAddress, linkedinUrl } from "../data/site";

const currentYear = new Date().getFullYear();
const mailto = `mailto:${emailAddress}?subject=PM%20Portfolio%20-%20Let's%20Talk`;
---

<footer class="relative overflow-hidden border-t border-color-border bg-color-bg px-4 py-14 text-color-text-primary sm:px-6 lg:px-8">
  <div class="footer-watermark pointer-events-none absolute inset-x-0 top-6 text-center font-display-en text-[18vw] font-semibold leading-none text-color-accent-dark opacity-[0.15]" aria-hidden="true">
    HOSHEN LICHI
  </div>

  <div class="relative mx-auto grid max-w-6xl gap-10 md:grid-cols-[1.2fr_0.8fr_0.8fr]">
    <div>
      <h2 class="text-xl font-semibold">Hoshen Lichi</h2>
      <p class="mt-2 max-w-sm text-sm leading-[1.6] text-color-text-secondary">
        Junior Product Manager · AI-powered product thinking
      </p>
    </div>

    <nav aria-label="Footer navigation">
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-[0.08em] text-color-text-secondary">Navigate</h3>
      <ul class="space-y-2 text-sm">
        <li><a class="hover:text-color-link" href="#about">About</a></li>
        <li><a class="hover:text-color-link" href="#projects">Projects</a></li>
        <li><a class="hover:text-color-link" href="#contact">Let's Talk</a></li>
        <li><a class="hover:text-color-link" href={cvUrl} download>Download CV</a></li>
      </ul>
    </nav>

    <div>
      <h3 class="mb-3 text-sm font-semibold uppercase tracking-[0.08em] text-color-text-secondary">Social</h3>
      <ul class="space-y-2 text-sm">
        <li><a class="hover:text-color-link" href={linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a class="hover:text-color-link" href={mailto}>Email</a></li>
      </ul>
    </div>
  </div>

  <div class="relative mx-auto mt-12 flex max-w-6xl flex-col gap-4 border-t border-color-border pt-5 text-sm text-color-text-secondary sm:flex-row sm:items-center sm:justify-between">
    <div class="flex h-12 w-12 items-center justify-center rounded-lg border border-color-border bg-color-surface font-display-en text-xl font-semibold italic text-color-accent-dark">
      HL
    </div>
    <p>© {currentYear} Hoshen Lichi. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer-watermark {
    animation: footer-drift 18s ease-in-out infinite alternate;
  }

  @keyframes footer-drift {
    from {
      transform: translate3d(-1.5rem, 0, 0);
    }

    to {
      transform: translate3d(1.5rem, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-watermark {
      animation: none;
    }
  }
</style>
